{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cluster_id",
    "working_title",
    "event_summary",
    "timeline",
    "facts",
    "quotes",
    "conflicts",
    "unique_source_contributions",
    "unverified_claims"
  ],
  "properties": {
    "cluster_id": { "type": "string", "minLength": 1 },
    "working_title": { "type": "string", "minLength": 1 },
    "event_summary": { "type": "string", "minLength": 1 },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "event", "source_ids"],
        "properties": {
          "date": { "type": "string" },
          "event": { "type": "string" },
          "source_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "claim", "source_ids", "confidence", "conflicted"],
        "properties": {
          "fact_id": { "type": "string" },
          "claim": { "type": "string" },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
          "conflicted": { "type": "boolean" }
        }
      }
    },
    "quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "speaker", "source_ids", "approved"],
        "properties": {
          "text": { "type": "string" },
          "speaker": { "type": "string" },
          "source_ids": { "type": "array", "items": { "type": "string" } },
          "approved": { "type": "boolean" }
        }
      }
    },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "unique_source_contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "facts"],
        "properties": {
          "source_id": { "type": "string" },
          "facts": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "unverified_claims": { "type": "array", "items": { "type": "string" } }
  }
}
