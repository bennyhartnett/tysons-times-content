{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["primary_article_id", "comparisons"],
  "properties": {
    "primary_article_id": { "type": "string", "minLength": 1 },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_id", "relationship", "confidence", "explanation", "recommended_action"],
        "properties": {
          "target_id": { "type": "string", "minLength": 1 },
          "relationship": { "type": "string", "enum": ["same_event", "follow_up", "same_topic_different_event", "background", "syndicated_copy", "unrelated", "uncertain"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "explanation": { "type": "string", "minLength": 1 },
          "recommended_action": { "type": "string", "enum": ["same_cluster", "link_as_related", "new_cluster", "manual_review"] }
        }
      }
    }
  }
}
